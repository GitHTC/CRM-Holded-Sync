{
  "manifest_version": 3,
  "name": "Segurnube · Holded CRM y Proyectos",
  "description": "Gestiona oportunidades, tareas y registro de tiempos de Holded sin salir de Google Workspace.",
  "version": "3.0.0",
  "action": {
    "default_title": "Holded Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://chat.google.com/*",
        "https://calendar.google.com/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://REPLACE_GATEWAY_URL/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://chat.google.com/*",
        "https://calendar.google.com/*",
        "https://drive.google.com/*"
      ]
    }
  ],
  "oauth2": {
    "client_id": "REPLACE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}