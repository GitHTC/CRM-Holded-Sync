# ===== Gateway seguro (servidor) =====
# Clave API de Holded (la pone SOLO el administrador; en producción usa Secret Manager)
HOLDED_API_KEY=""
# Client ID OAuth de tipo "Extensión de Chrome" (Google Cloud > APIs y servicios > Credenciales)
GOOGLE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"
# Dominios de Google Workspace con acceso (separados por comas)
ALLOWED_DOMAINS="tudominio.com"
# Opcional: orígenes web extra permitidos por CORS
ALLOWED_ORIGINS=""
# Solo desarrollo local (se ignora si NODE_ENV=production): entra como este usuario sin Google
DEV_AUTH_EMAIL=""

# ===== Empaquetado de la extensión (npm run build) =====
# GATEWAY_URL="https://tu-gateway.run.app"
# OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"
